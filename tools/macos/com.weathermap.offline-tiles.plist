<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.weathermap.offline-tiles</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>/Users/ingolfhorsch/Projekte/WeatherMap/tools/macos/run_offline_tiles_nightly.sh</string>
    </array>

    <!-- Run nightly at 23:30 local time -->
    <key>StartCalendarInterval</key>
    <dict>
      <key>Hour</key>
      <integer>23</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>

    <!-- Keep the job alive only while running; do not auto-restart on clean exit -->
    <key>KeepAlive</key>
    <false/>

    <!-- Limit how many times launchd retries if it fails quickly -->
    <key>ThrottleInterval</key>
    <integer>300</integer>

    <!-- launchd itself will capture stdout/stderr, but we also log inside the script -->
    <key>StandardOutPath</key>
    <string>/tmp/weathermap-offline-tiles.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/weathermap-offline-tiles.err</string>
  </dict>
</plist>
